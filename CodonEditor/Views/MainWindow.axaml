<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodonEditor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:e="clr-namespace:EventBinder;assembly=EventBinder.Avalonia"
		xmlns:custom="using:CodonEditor.Controls"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CodonEditor.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="CodonEditor">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

	<Panel Background="Gray" Margin="100">
	    <custom:DrawingManager/>
	</Panel>
</Window>
