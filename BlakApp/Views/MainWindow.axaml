<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlakApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BlakApp.Views.MainWindow"
        Icon="/Assets/icon.ico"
        Title="BlakApp">
	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<DockPanel Name="MainStackPanel">
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Data"/>
			<MenuItem Header="Theme"/>
			<MenuItem Header="About"/>
		</Menu>
		<StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
			<Button Command="{Binding GoToDefault}" Content="H"/>
			<ItemsControl Items="{Binding Pages}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button Command="{Binding $parent[ItemsControl].DataContext.ChangePage}" CommandParameter="{Binding}" Foreground="{Binding Color}" Content="{Binding Name}" > 
							<TextBlock Text="{Binding Name}"/>
							<Button.ContextMenu>
								<ContextMenu Padding="0,0,-24,0">
									<MenuItem Command="{Binding #MainStackPanel.DataContext.RemovePage}" CommandParameter="{Binding}" Header="Close"/>
								</ContextMenu>
							</Button.ContextMenu>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
			<Button Content="+" Click="AddNewPanelContextMenuClicked">
				<Button.ContextMenu >
					<ContextMenu Name="AddNewPanelContextMenu" Padding="0,0,-24,0">
						<MenuItem Command="{Binding CreatePage}" CommandParameter="0" Header="Sequence Analyzer"/>
						<MenuItem Command="{Binding CreatePage}" CommandParameter="1" Header="Peptide Draw Tool"/>
						<MenuItem Command="{Binding CreatePage}" CommandParameter="2" Header="Peptide Analyzer" />
						<MenuItem Command="{Binding CreatePage}" CommandParameter="3" Header="Test view" />
					</ContextMenu>
				</Button.ContextMenu>
			</Button>
		</StackPanel>
		
		<Panel>
			<ContentControl Content="{Binding CurrentPage}"/>
		</Panel>
	</DockPanel>

</Window>
