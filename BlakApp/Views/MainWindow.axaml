<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BlakApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BlakApp.Views.MainWindow"
        Icon="/Assets/icon.ico"
        Title="BlakApp"
		ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
		
		MinWidth="600"
		MinHeight="400">
	
	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>
	
	<Window.Styles>
		<StyleInclude Source="/Views/Style/Main.axaml" />
	</Window.Styles>

	<DockPanel Name="MainStackPanel">
		<Panel DockPanel.Dock="Top"  IsHitTestVisible="False" Background="#111111"  Height="30">
			<!--Toolbar-->
			<Label Padding="10,0,0,0" VerticalAlignment="Center" Content="BlakApp" FontSize="16"/>
		</Panel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Theme"/>
			<MenuItem Header="About"/>
		</Menu>
		<ScrollViewer   HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Auto" DockPanel.Dock="Top">			
			<StackPanel Background="#070707" Orientation="Horizontal" >
				<Button Command="{Binding GoToDefault}" Background="Transparent"  Width="30" Height="30" Padding="2" Margin="5,0,0,0">
					<Image Source="avares://BlakApp/Assets/Home.png"/>
				</Button>

				<ItemsControl Items="{Binding Pages}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Height="30" Command="{Binding $parent[ItemsControl].DataContext.ChangePage}" CommandParameter="{Binding}" Foreground="{Binding Color}" Content="{Binding Name}" >
								<TextBlock Text="{Binding Name}"/>
								<Button.ContextMenu>
									<ContextMenu Padding="0,0,-24,0">
										<MenuItem Command="{Binding #MainStackPanel.DataContext.RemovePage}" CommandParameter="{Binding}" Header="Close"/>
									</ContextMenu>
								</Button.ContextMenu>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Button Height="30" Width="30" FontSize="20" Padding="4" Background="Transparent" Click="AddNewPanelContextMenuClicked">
					<Image Source="avares://BlakApp/Assets/Plus.png"/>
					
					<Button.ContextMenu >
						<ContextMenu Name="AddNewPanelContextMenu" Padding="0,0,-24,0">
							<MenuItem Command="{Binding CreatePage}" CommandParameter="0" Header="Sequence Analyzer"/>
							<MenuItem Command="{Binding CreatePage}" CommandParameter="1" Header="Peptide Draw Tool"/>
							<MenuItem Command="{Binding CreatePage}" CommandParameter="2" Header="Peptide Analyzer" />
							<MenuItem Command="{Binding CreatePage}" CommandParameter="3" Header="Test view" />
						</ContextMenu>
					</Button.ContextMenu>
				</Button>
			</StackPanel>
		</ScrollViewer>
		
		<Panel>
			<ContentControl Content="{Binding CurrentPage}"/>
		</Panel>
	</DockPanel>

</Window>
